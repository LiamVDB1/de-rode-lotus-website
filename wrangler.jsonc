{
  "name": "de-rode-lotus",
  "compatibility_date": "2026-09-25",
  "main": "worker/index.js",
  "workers_dev": true,
  "routes": [
    { "pattern": "derodelotus.com", "custom_domain": true },
    { "pattern": "www.derodelotus.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
