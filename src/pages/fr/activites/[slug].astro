---
import ActivityPage from '../../../components/pages/ActivityPage.astro';
import { loadView } from '../../../lib/view';

const view = await loadView(Astro.locals, 'fr');
const activity = view.docs.activities.find((item) => item.slug === Astro.params.slug);
if (!activity) return Astro.rewrite('/404');
---
<ActivityPage view={view} activity={activity} />
