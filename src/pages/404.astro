---
import PublicLayout from '../layouts/PublicLayout.astro';
import { langFromPath, pathFor, strings } from '../lib/i18n';
import { loadView } from '../lib/view';

// Na een rewrite (onbekende activiteit) telt het oorspronkelijke pad.
const lang = langFromPath(Astro.originPathname);
const view = await loadView(Astro.locals, lang);
const t = strings(lang);
Astro.response.status = 404;
---
<PublicLayout view={view} page={{ page: 'notFound' }} title={`${t.notFoundTitle} — De Rode Lotus`} description={t.notFoundDescription} plainNav>
  <section class="page-head not-found">
    <h1>{t.notFoundHeading}</h1>
    <p>{t.notFoundText}</p>
    <a class="button" href={pathFor(lang, { page: 'home' })}>{t.notFoundHome}</a>
  </section>
</PublicLayout>
