---
import PublicLayout from '../layouts/PublicLayout.astro';
import { loadDocuments } from '../lib/content';

const docs = await loadDocuments(Astro.locals.draft ? 'draft' : 'published');
Astro.response.status = 404;
---
<PublicLayout docs={docs} title="Pagina niet gevonden — De Rode Lotus" description="Deze pagina bestaat niet (meer)." plainNav>
  <section class="page-head not-found">
    <h1>Deze pagina vinden we niet.</h1>
    <p>Misschien is ze verhuisd of bestaat ze niet meer.</p>
    <a class="button" href="/">Naar de startpagina</a>
  </section>
</PublicLayout>
