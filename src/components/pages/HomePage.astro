---
import PublicLayout from '../../layouts/PublicLayout.astro';
import Logo from '../Logo.astro';
import Arrow from '../Arrow.astro';
import { fill, listJoin, pathFor, strings } from '../../lib/i18n';
import { hasPhoto, phoneHref, routeHref } from '../../lib/site';
import type { View } from '../../lib/view';

interface Props { view: View }
const { view } = Astro.props;
const { docs, lang, source } = view;
const t = strings(lang);
const { home, practical, activities, faq, notice, donate } = docs;

const emailHref = `mailto:${encodeURIComponent(practical.email)}`;
const phoneLink = phoneHref(practical.phoneInternational);
const routeLink = routeHref(practical.street, practical.postalCode, practical.city);
// Engelse dagnamen krijgen een hoofdletter, Nederlandse en Franse niet.
const days = practical.hours.map(({ day }) => (lang === 'en' ? day : day.toLowerCase()));
const hoursList = listJoin(lang, days);
const hoursSummary = hoursList.charAt(0).toUpperCase() + hoursList.slice(1);
/** Het script markeert vandaag aan de hand van de Nederlandse dagnaam. */
const dayKey = (index: number) => source.practical.hours[index]?.day.toLowerCase() ?? '';
const showNotice = notice.enabled && notice.title && notice.message;
const donateDialog = donate.enabled && donate.iban !== '';
const showCat = hasPhoto(home.catPhoto) && home.catName !== '';
---
<PublicLayout view={view} page={{ page: 'home' }} title={home.pageTitle} description={home.metaDescription}>
  <section class="hero" id="top" aria-labelledby="hero-title">
    {hasPhoto(home.heroPhoto) && <figure class="hero-image"><img src={home.heroPhoto} width="2048" height="1365" decoding="async" fetchpriority="high" alt={home.heroPhotoAlt} /></figure>}
    <div class="hero-content">
      <h1 id="hero-title">{home.heroTitle}</h1>
      <p>{home.heroIntro}</p>
      <div class="actions">
        <a class="button" href="#praktisch">{t.ctaPractical} <Arrow /></a>
        <a class="button light" href="#helpen">{t.ctaHelp} <Arrow /></a>
      </div>
    </div>
  </section>

  <div class="quick-wrap">
    <div class="quick" aria-label={t.quickLabel}>
      <article>
        <span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M10 18s6-5.2 6-10a6 6 0 1 0-12 0c0 4.8 6 10 6 10Z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="10" cy="8" r="2" fill="currentColor"/></svg></span>
        <div><strong>{practical.street}</strong><p>{practical.postalCode} {practical.city} · {practical.neighbourhood}</p><a href={routeLink} target="_blank" rel="noopener noreferrer">{t.route}</a></div>
      </article>
      <article>
        <span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 6v4l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
        <div><strong>{t.hoursHeading}</strong><p>{hoursSummary}</p><a href="#praktisch">{t.allHours}</a></div>
      </article>
      <article>
        <span class="quick-icon" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M6 14 14 6m-6 0h6v6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <div><strong>{t.askUs}</strong><p><a href={phoneLink}>{practical.phoneDisplay}</a><br /><a href={emailHref}>{practical.email}</a></p></div>
      </article>
    </div>
  </div>

  {showNotice && <aside class="notice" data-until={notice.until} aria-label={t.noticeLabel}><div><strong>{notice.title}</strong><p>{notice.message}</p></div><button type="button" aria-label={t.noticeClose}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg></button></aside>}

  <section class="section" id="wat-we-doen" aria-labelledby="services-title">
    <div class="section-head"><h2 id="services-title">{home.servicesTitle}</h2><p>{home.servicesIntro}</p></div>
    <div class="services">
      {activities.map((activity) => <a class="service" href={pathFor(lang, { page: 'activity', slug: activity.slug })}>
        {hasPhoto(activity.photo)
          ? <img src={activity.photo} width="400" height="290" loading="lazy" decoding="async" alt={activity.photoAlt} />
          : <span class="photo-placeholder" aria-hidden="true"><Logo id={`ph-${activity.slug}`} /></span>}
        <div class="service-copy">
          <h3>{activity.title}</h3>
          {activity.when && <span class="service-when">{activity.when}</span>}
          <p>{activity.description}</p>
          <span class="service-more">{t.moreAbout} {activity.title.toLowerCase()} <Arrow /></span>
        </div>
      </a>)}
    </div>
  </section>

  <section class="practical" id="praktisch" aria-labelledby="hours-title">
    <div class="practical-inner">
      <div class="section-head"><h2 id="hours-title">{practical.hoursTitle}</h2><p>{practical.hoursIntro}</p><a class="practical-social" href={practical.facebookUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H7.8v3h2.6V21h3.1Z" fill="currentColor"/></svg><span>{t.facebookClosed}</span></a></div>
      <ul class="hours" data-today-label={t.today}>
        {practical.hours.map((item, index) => <li data-day={dayKey(index)}><strong>{item.day}</strong><span class="hour-time">{item.time}</span><p>{item.activity}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="story" aria-labelledby="story-title">
    <figure class="story-photo">
      {hasPhoto(home.storyPhoto) ? <img src={home.storyPhoto} width="400" height="290" loading="lazy" decoding="async" alt={home.storyPhotoAlt} /> : <span class="photo-placeholder" aria-hidden="true"><Logo id="ph-story" /></span>}
    </figure>
    <div class="story-copy"><h2 id="story-title">{home.storyTitle}</h2><p>{home.storyText}</p><a class="button" href={pathFor(lang, { page: 'volunteers' })}>{t.meetTeam} <Arrow /></a></div>
  </section>

  {showCat && <section class="cat" aria-labelledby="cat-title">
    <img src={home.catPhoto} width="480" height="480" loading="lazy" decoding="async" alt={home.catPhotoAlt} />
    <div><span class="eyebrow">{t.catEyebrow}</span><h2 id="cat-title">{fill(t.catHeading, { name: home.catName })}</h2>{home.catText && <p>{home.catText}</p>}</div>
  </section>}

  <section class="help" id="helpen" aria-labelledby="help-title">
    <div><h2 id="help-title">{home.helpTitle}</h2><p>{home.helpIntro}</p></div>
    <div class="help-actions">
      <a href={`${pathFor(lang, { page: 'volunteers' })}#aanmelden`}><span>{t.helpVolunteer}</span><Arrow /></a>
      <a href={phoneLink}><span>{t.helpBring}</span><Arrow /></a>
      {donateDialog && <a class="help-donate" href="#doneren" data-open-donate><span>{t.helpDonate}</span><Arrow /></a>}
      <a href={emailHref}><span>{t.helpQuestion}</span><Arrow /></a>
    </div>
  </section>

  <section class="section faq" id="vragen" aria-labelledby="faq-title">
    <div class="section-head"><h2 id="faq-title">{home.faqTitle}</h2><p>{home.faqIntro}</p></div>
    <div class="faq-list">{faq.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </section>
</PublicLayout>

<script>
  const notice = document.querySelector<HTMLElement>('.notice');
  if (notice) {
    const until = notice.dataset.until;
    const todayInGent = new Date().toLocaleDateString('sv-SE', { timeZone: 'Europe/Brussels' });
    if (until && /^\d{4}-\d{2}-\d{2}$/.test(until) && todayInGent > until) notice.remove();
    notice.querySelector('button')?.addEventListener('click', () => notice.remove());
  }

  // Markeer de dag van vandaag in de openingsuren.
  const weekday = new Date().toLocaleDateString('nl-BE', { weekday: 'long', timeZone: 'Europe/Brussels' });
  const today = document.querySelector<HTMLElement>(`.hours li[data-day="${CSS.escape(weekday)}"]`);
  if (today) {
    today.dataset.today = '';
    const badge = document.createElement('span');
    badge.className = 'today-badge';
    badge.textContent = today.parentElement?.dataset.todayLabel ?? '';
    today.append(badge);
  }
</script>
