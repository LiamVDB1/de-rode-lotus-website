---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../styles/site.css';
import '../styles/pages.css';
import Logo from '../components/Logo.astro';
import DonateDialog from '../components/DonateDialog.astro';
import { LANG_NAMES, LANGS, pathFor, strings, type Lang, type Page } from '../lib/i18n';
import { phoneHref } from '../lib/site';
import { isIndexableHost } from '../lib/http';
import type { View } from '../lib/view';

interface Props {
  view: View;
  /** Deze pagina, om naar dezelfde pagina in een andere taal te linken. */
  page: Page;
  title: string;
  description: string;
  /** Pagina's zonder donkere hero krijgen een effen menubalk. */
  plainNav?: boolean;
}
const { view, page, title, description, plainNav = false } = Astro.props;
const { docs, lang } = view;
const t = strings(lang);
const { practical, donate } = docs;
const home = pathFor(lang, { page: 'home' });
const anchor = (id: string) => `${home === '/' ? '' : home}/#${id}`;
const alternates = page.page === 'notFound' ? [] : LANGS.map((code: Lang) => ({ code, href: pathFor(code, page) }));
const absolute = (path: string) => new URL(path, Astro.url.origin).toString();
const emailHref = `mailto:${encodeURIComponent(practical.email)}`;
const phoneLink = phoneHref(practical.phoneInternational);
const donateDialog = donate.enabled && donate.iban !== '';
const draft = Astro.locals.draft;
const indexable = !draft && isIndexableHost(Astro.url);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#173252" />
    <meta name="description" content={description} />
    {indexable ? <link rel="canonical" href={new URL(Astro.url.pathname, Astro.url.origin).toString()} /> : <meta name="robots" content="noindex, nofollow" />}
    {indexable && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.code} href={absolute(alternate.href)} />)}
    {indexable && alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={absolute(alternates[0].href)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {/* De andere taalversies alvast ophalen zodra iemand naar de taalkeuze gaat. */}
    {alternates.length > 0 && <script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { selector_matches: '.lang-switch a' }, eagerness: 'moderate' }] })} />}
  </head>
  <body class:list={{ 'plain-nav': plainNav }}>
    <a class="skip-link" href="#inhoud">{t.skipLink}</a>
    {draft && <div class="draft-bar" role="status"><span><strong>{t.draftLabel}</strong> · {t.draftBar}</span><a href="/beheer">{t.draftBack}</a>{!Astro.url.hostname.startsWith('preview.') && <form method="post" action="/beheer/voorbeeld"><input type="hidden" name="aan" value="0" /><input type="hidden" name="naar" value={Astro.url.pathname} /><button type="submit">{t.draftOff}</button></form>}</div>}
    <div class="nav-wrap">
      <header class="site-nav" data-menu="closed" aria-label={t.mainNav}>
        <a class="brand" href={home} aria-label={t.homeLabel}>
          <Logo id="nav-logo" />
          <strong>De Rode Lotus</strong>
        </a>
        <nav class="nav-links" id="primary-menu" aria-label={t.mainMenu} data-label-open={t.menuOpen} data-label-close={t.menuClose}>
          <a href={anchor('wat-we-doen')}>{t.navServices}</a>
          <a href={anchor('praktisch')}>{t.navPractical}</a>
          <a href={pathFor(lang, { page: 'volunteers' })}>{t.navVolunteers}</a>
          <a href={anchor('vragen')}>{t.navFaq}</a>
          {donateDialog && <a class="donate" href="#doneren" data-open-donate>{t.navDonate}</a>}
          <a class="contact" href={emailHref}>{t.navContact}</a>
          {alternates.length > 0 && <ul class="lang-switch" aria-label={t.languages}>
            {alternates.map((alternate) => <li><a href={alternate.href} hreflang={alternate.code} lang={alternate.code} aria-label={LANG_NAMES[alternate.code]} aria-current={alternate.code === lang ? 'true' : undefined}>{alternate.code.toUpperCase()}</a></li>)}
          </ul>}
        </nav>
        <button class="mobile-menu" type="button" aria-expanded="false" aria-controls="primary-menu" aria-label={t.menuOpen}>
          <svg class="menu-open-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <svg class="menu-close-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 5 10 10M15 5 5 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
      </header>
    </div>

    <main id="inhoud"><slot /></main>

    <footer>
      <div class="footer-main">
        <div class="footer-brand">
          <Logo id="footer-logo" class="footer-logo" />
          <div><strong>De Rode Lotus</strong><p>{practical.street} · {practical.postalCode} {practical.city} · <a href={phoneLink}>{practical.phoneDisplay}</a> · <a href={emailHref}>{practical.email}</a></p></div>
        </div>
        <div class="footer-social">
          {donateDialog && <a href="#doneren" data-open-donate><span>{t.footerGift}</span></a>}
          <a href={practical.facebookUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10.5H7.8v3h2.6V21h3.1Z" fill="currentColor"/></svg><span>Facebook</span></a>
          {practical.instagramUrl && <a href={practical.instagramUrl} target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg><span>Instagram</span></a>}
        </div>
      </div>
      <p class="footer-bottom">{t.footerTagline}</p>
    </footer>

    {donateDialog && <DonateDialog donate={donate} lang={lang} />}

    <script>
      const nav = document.querySelector<HTMLElement>('.site-nav');
      const menuButton = document.querySelector<HTMLButtonElement>('.mobile-menu');
      const setMenu = (open: boolean) => {
        if (!nav || !menuButton) return;
        nav.dataset.menu = open ? 'open' : 'closed';
        menuButton.setAttribute('aria-expanded', String(open));
        const labels = document.querySelector<HTMLElement>('#primary-menu')?.dataset;
        menuButton.setAttribute('aria-label', (open ? labels?.labelClose : labels?.labelOpen) ?? '');
      };
      menuButton?.addEventListener('click', () => setMenu(nav?.dataset.menu !== 'open'));
      nav?.querySelectorAll<HTMLAnchorElement>('.nav-links a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || nav?.dataset.menu !== 'open') return;
        setMenu(false);
        menuButton?.focus();
      });
      document.addEventListener('pointerdown', (event) => {
        if (nav?.dataset.menu === 'open' && !nav.contains(event.target as Node)) setMenu(false);
      });
    </script>
    <script is:inline>
      // Van taal wisselen houdt je op dezelfde plek: we onthouden welk element bovenaan stond en
      // scrollen er op de nieuwe pagina naartoe, vóór die getoond wordt. De pagina's in de drie
      // talen hebben dezelfde opbouw, dus het n-de element in <main> is overal hetzelfde stuk.
      (() => {
        const KEY = 'lotus-lang-switch';
        const elements = () => document.querySelectorAll('main *');
        const read = () => {
          try { return JSON.parse(sessionStorage.getItem(KEY) || 'null'); } catch { return null; }
        };

        document.querySelectorAll('.lang-switch a').forEach((link) =>
          link.addEventListener('click', (event) => {
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const nodes = elements();
            let index = -1;
            let offset = 0;
            if (window.scrollY > 10) {
              for (let i = 0; i < nodes.length; i += 1) {
                const box = nodes[i].getBoundingClientRect();
                if (box.height > 0 && box.top >= 0) {
                  index = i;
                  offset = box.top;
                  break;
                }
              }
            }
            try { sessionStorage.setItem(KEY, JSON.stringify({ to: link.pathname, index, offset, at: Date.now() })); } catch {}
          }),
        );

        // Alleen een taalwissel krijgt de overvloeier; gewone links laden zoals altijd.
        window.addEventListener('pageswap', (event) => {
          if (event.viewTransition && !read()) event.viewTransition.skipTransition();
        });

        const saved = read();
        try { sessionStorage.removeItem(KEY); } catch {}
        if (!saved || saved.to !== location.pathname || Date.now() - saved.at > 15000 || saved.index < 0) return;
        const restore = () => {
          const target = elements()[saved.index];
          if (target) window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - saved.offset, behavior: 'instant' });
          return window.scrollY;
        };
        // Zodra de bezoeker zelf scrolt, laten we de positie met rust.
        let touched = false;
        const stop = () => { touched = true; };
        ['wheel', 'touchstart', 'keydown', 'pointerdown'].forEach((type) => window.addEventListener(type, stop, { once: true, passive: true }));
        const again = () => { if (!touched) restore(); };
        restore();
        // Schuift de pagina nog (opmaak, lettertypes, foto's), dan volgen we even mee.
        const observer = new ResizeObserver(again);
        observer.observe(document.body);
        window.setTimeout(() => observer.disconnect(), 2000);
      })();
    </script>
  </body>
</html>
